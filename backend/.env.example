# Copy this file to .env and fill in your own deployment URL.
#
# Apps Script Web App endpoint that serves the menu spreadsheet as JSON.
# Deploy it with:
#   Execute as:      Me
#   Who has access:  Anyone      <- "Anyone with Google account" will NOT work
#
# Verify with:  curl -sL "<url>" | head -c 200   (expect JSON, not <!doctype)
GOOGLE_SHEETS_API_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXX/exec

# How often to re-pull the menu from the sheet, in seconds. 0 disables it.
# WARNING: each pull costs ~4.6s of Google's daily Apps Script runtime quota
# (90 min/day consumer, 6 h/day Workspace). 5s is for demos/editing sessions;
# use 60 or more for anything left running.
MENU_SYNC_INTERVAL_SECONDS=5
